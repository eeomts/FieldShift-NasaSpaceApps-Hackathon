# Copie para .env e preencha. O .env NUNCA vai para o git.

# Banco de produção (VPS). Não use localhost aqui.
DB_HOST=2.24.30.217
DB_PORT=5433
DB_NAME=agricultura
DB_USER=agricultura_app
DB_PASSWORD=
# "require" quando o SSL estiver ligado no Postgres da VPS
DB_SSLMODE=prefer

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_MIN=10080

# Opcional. Sem chave, o onboarding usa a lista de culturas como reserva.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Token do Earthdata Login (https://urs.earthdata.nasa.gov > Generate Token). Opcional:
# sem ele, o Dashboard mostra só o clima do NASA POWER.
EARTHDATA_TOKEN=

CORS_ORIGINS=http://localhost:5173
