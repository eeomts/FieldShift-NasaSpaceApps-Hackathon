#!/bin/sh
# Sobe o AgroAI com Docker: ./.deploy/agroai <local|producao> <comando do docker compose>

set -eu

cd "$(dirname "$0")/.."
. .deploy/lib.sh

if [ $# -lt 2 ]; then
    echo "uso: ./.deploy/agroai <local|producao> <comando do docker compose>" >&2
    echo "  ex.: ./.deploy/agroai local up -d --build" >&2
    echo "       ./.deploy/agroai producao logs -f api" >&2
    exit 1
fi

carregar_env "$1"
shift

exigir SITE SITE_DEMO DB_HOST DB_NAME DB_USER DB_PASSWORD JWT_SECRET

if [ ${#JWT_SECRET} -lt 32 ]; then
    echo "erro: JWT_SECRET precisa de pelo menos 32 caracteres." >&2
    echo "  gere com: python -c \"import secrets; print(secrets.token_urlsafe(48))\"" >&2
    exit 1
fi

# ------------------------------------------------------------------ endereco

# separar_site <url>: preenche ESQUEMA, DOMINIO e PORTA (a padrao do esquema, se a url nao trouxer)
separar_site() {
    url=${1%/}
    ESQUEMA=${url%%://*}
    autoridade=${url#*://}
    autoridade=${autoridade%%/*}
    case "$ESQUEMA" in
        http) PORTA=80 ;;
        https) PORTA=443 ;;
        *)
            echo "erro: endereco sem http:// ou https://: $1" >&2
            exit 1
            ;;
    esac
    case "$autoridade" in
        *:*)
            PORTA=${autoridade##*:}
            DOMINIO=${autoridade%%:*}
            ;;
        *)
            DOMINIO=$autoridade
            ;;
    esac
}

separar_site "$SITE_DEMO"
ESQUEMA_DEMO=$ESQUEMA
DOMINIO_DEMO=$DOMINIO
PORTA_DEMO=$PORTA

separar_site "$SITE"
SITE=${SITE%/}
SITE_DEMO=${SITE_DEMO%/}

# Os dois sites dividem o mesmo Caddy: so o dominio muda.
if [ "$ESQUEMA_DEMO" != "$ESQUEMA" ] || [ "$PORTA_DEMO" != "$PORTA" ]; then
    echo "erro: SITE_DEMO precisa do mesmo esquema e da mesma porta do SITE." >&2
    echo "  ex.: SITE=$ESQUEMA://$DOMINIO:$PORTA   SITE_DEMO=$ESQUEMA://demo.$DOMINIO:$PORTA" >&2
    exit 1
fi
if [ "$DOMINIO_DEMO" = "$DOMINIO" ]; then
    echo "erro: SITE e SITE_DEMO precisam de dominios diferentes." >&2
    exit 1
fi

# O Caddy escuta nas portas padrao dentro do container; a porta do SITE vira publicacao.
PORTA_HTTP=$PORTA
if [ "$ESQUEMA" = "https" ]; then
    PORTA_HTTP=80
fi

# PROXY: um nginx do host ja ocupa 80/443 e cuida do TLS; o Caddy vira HTTP so na maquina
# e separa os dois sites pelo Host que o nginx repassa.
PROXY=${PROXY:-}
if [ -n "$PROXY" ]; then
    case "$PROXY" in
        *:*) ;;
        *) PROXY="127.0.0.1:$PROXY" ;;
    esac
    export AGROAI_SITE="http://$DOMINIO"
    export AGROAI_SITE_DEMO="http://$DOMINIO_DEMO"
    export AGROAI_PORTA_HTTP="$PROXY"
    export AGROAI_PORTA_HTTPS="127.0.0.1:"
else
    export AGROAI_SITE="$ESQUEMA://$DOMINIO"
    export AGROAI_SITE_DEMO="$ESQUEMA://$DOMINIO_DEMO"
    export AGROAI_PORTA_HTTP="$PORTA_HTTP"
    if [ "$ESQUEMA" = "https" ]; then
        export AGROAI_PORTA_HTTPS="${PORTA_HTTPS:-443}"
    else
        # site em http (local): a 443 nao e usada; porta aleatoria so nesta maquina, sem disputar a 443
        export AGROAI_PORTA_HTTPS="127.0.0.1:"
    fi
fi

# --------------------------------------------------------------------- banco

if [ "$DB_HOST" = "db" ]; then
    # banco dentro do compose (Postgres 17 + pgvector + PostGIS)
    export COMPOSE_PROFILES="banco"
    export DB_PORT=5432
    export DB_SSLMODE=${DB_SSLMODE:-disable}
else
    export COMPOSE_PROFILES=""
    case "$DB_HOST" in
        localhost|127.0.0.1)
            echo "aviso: DB_HOST=$DB_HOST e o proprio container da API, nao a sua maquina." >&2
            echo "       para um Postgres fora do Docker nesta maquina use host.docker.internal." >&2
            ;;
    esac
fi

export CORS_ORIGINS=${CORS_ORIGINS:-$SITE,$SITE_DEMO}

# O nome do projeto continua "agroia-<ambiente>" de propósito: os volumes do banco e dos
# certificados na VPS foram criados com esse nome. Trocar para agroai criaria volumes novos e vazios.
exec docker compose -p "agroia-$AMBIENTE" -f .deploy/compose.yml "$@"
