#!/bin/sh
# Sobe o AgroIA com Docker: ./.deploy/agroia <local|producao> <comando do docker compose>

set -eu

cd "$(dirname "$0")/.."
. .deploy/lib.sh

if [ $# -lt 2 ]; then
    echo "uso: ./.deploy/agroia <local|producao> <comando do docker compose>" >&2
    echo "  ex.: ./.deploy/agroia local up -d --build" >&2
    echo "       ./.deploy/agroia producao logs -f api" >&2
    exit 1
fi

carregar_env "$1"
shift

exigir SITE DB_HOST DB_NAME DB_USER DB_PASSWORD JWT_SECRET

if [ ${#JWT_SECRET} -lt 32 ]; then
    echo "erro: JWT_SECRET precisa de pelo menos 32 caracteres." >&2
    echo "  gere com: python -c \"import secrets; print(secrets.token_urlsafe(48))\"" >&2
    exit 1
fi

# ------------------------------------------------------------------ endereco

SITE=${SITE%/}
ESQUEMA=${SITE%%://*}
AUTORIDADE=${SITE#*://}
AUTORIDADE=${AUTORIDADE%%/*}

# O Caddy escuta nas portas padrao dentro do container; a porta do SITE vira publicacao.
case "$AUTORIDADE" in
    *:*)
        PORTA_HTTP=${AUTORIDADE##*:}
        DOMINIO=${AUTORIDADE%%:*}
        ;;
    *)
        PORTA_HTTP=80
        DOMINIO=$AUTORIDADE
        ;;
esac

# PROXY: um nginx do host ja ocupa 80/443 e cuida do TLS; o Caddy vira HTTP so na maquina.
PROXY=${PROXY:-}
if [ -n "$PROXY" ]; then
    case "$PROXY" in
        *:*) ;;
        *) PROXY="127.0.0.1:$PROXY" ;;
    esac
    export AGROIA_SITE=":80"
    export AGROIA_PORTA_HTTP="$PROXY"
    export AGROIA_PORTA_HTTPS="127.0.0.1:"
else
    export AGROIA_SITE="$ESQUEMA://$DOMINIO"
    export AGROIA_PORTA_HTTP="$PORTA_HTTP"
    if [ "$ESQUEMA" = "https" ]; then
        export AGROIA_PORTA_HTTPS="${PORTA_HTTPS:-443}"
    else
        # site em http (local): a 443 nao e usada; porta aleatoria so nesta maquina, sem disputar a 443
        export AGROIA_PORTA_HTTPS="127.0.0.1:"
    fi
fi

# --------------------------------------------------------------------- banco

if [ "$DB_HOST" = "db" ]; then
    # banco dentro do compose (Postgres 17 + pgvector + PostGIS)
    export COMPOSE_PROFILES="banco"
    export DB_PORT=5432
    export DB_SSLMODE=${DB_SSLMODE:-disable}
else
    export COMPOSE_PROFILES=""
    case "$DB_HOST" in
        localhost|127.0.0.1)
            echo "aviso: DB_HOST=$DB_HOST e o proprio container da API, nao a sua maquina." >&2
            echo "       para um Postgres fora do Docker nesta maquina use host.docker.internal." >&2
            ;;
    esac
fi

export CORS_ORIGINS=${CORS_ORIGINS:-$SITE}

exec docker compose -p "agroia-$AMBIENTE" -f .deploy/compose.yml "$@"
