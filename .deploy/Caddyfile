{
	# ninguém administra este Caddy pela API
	admin off
}

# Os endereços vêm do SITE e do SITE_DEMO do .deploy/env/<ambiente>.env, pelo ./.deploy/agroai.
# https://dominio -> certificado emitido e renovado sozinho
# http://dominio  -> HTTP puro, sem certificado (local, ou atrás do nginx do host com PROXY)

# Um site: {args[0]} é a pasta do build. Os dois usam a mesma API.
(site) {
	encode zstd gzip

	# arquivo oculto nunca é servido
	handle /.* {
		respond 404
	}

	# API: tira o /api e repassa
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# site: arquivo do build; rota do React cai no index.html
	handle {
		root * {args[0]}
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}

	# arquivos com hash no nome (o Vite gera em /assets) nunca mudam
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	log {
		output stderr
	}
}

# versão completa (agroai/web)
{$AGROAI_SITE} {
	import site /srv/web
}

# versão de apresentação (agroai/web-demo)
{$AGROAI_SITE_DEMO} {
	import site /srv/demo
}
