# Copie para .deploy/env/local.env ou .deploy/env/producao.env e preencha.
# Esses arquivos ficam fora do Git. Formato: CHAVE=valor, sem espaço em volta do =.

# Endereço do site. Local: http://localhost:9090 | Produção: https://agroia.SEU-DOMINIO.com
SITE=http://localhost:9090

# Só em VPS que já tem nginx na frente (ver .deploy/README.md). Vazio = o Caddy cuida do certificado.
PROXY=

# Banco. DB_HOST=db sobe um Postgres 17 (pgvector + PostGIS) junto, no próprio compose.
# Para usar um Postgres que já existe, ponha o endereço dele (e DB_PORT/DB_SSLMODE).
DB_HOST=db
DB_PORT=5432
DB_NAME=agricultura
DB_USER=agricultura_app
DB_PASSWORD=troque-esta-senha
DB_SSLMODE=disable

# Porta do banco do compose nesta máquina (só 127.0.0.1), para DBeaver/psql.
AGROIA_PORTA_BANCO=5434

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_MIN=10080

# Opcional. Sem chave, o onboarding usa a lista de culturas como reserva.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Backup (./.deploy/backup): dias guardados aqui e, opcional, remoto do rclone.
BACKUP_DIAS=14
BACKUP_REMOTO=
