# Banco LOCAL para desenvolver (container agroia-dev, porta 55432). Sem segredo real.
# Estas variáveis vencem o .env, então nada vai para a VPS e o Gemini fica desligado (sem custo).
DB_HOST=127.0.0.1
DB_PORT=55432
DB_PASSWORD=dev
DB_SSLMODE=disable
JWT_SECRET=segredo-de-desenvolvimento-com-mais-de-32-caracteres
GEMINI_API_KEY=
